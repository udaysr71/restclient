<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional: lets IDEs import the project. The app has NO dependencies.
  The recommended build is `java Build.java`, which needs only a JDK.
  Note that Maven itself downloads its plugins from Maven Central.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.restclient</groupId>
  <artifactId>restclient</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>REST Client</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Tests use the in-repo test kit; run them with `java Build.java test`. -->
    <skipTests>true</skipTests>
  </properties>

  <!-- Intentionally empty: no third-party code. -->
  <dependencies/>

  <build>
    <finalName>restclient</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.restclient.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
