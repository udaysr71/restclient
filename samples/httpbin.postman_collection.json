          "response": []
        },
        {
          "name": "XML body",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\"?>\n<order>\n  <id>{{userId}}</id>\n  <item sku=\"MUG-01\">Coffee mug</item>\n</order>",
              "options": {
                "raw": {
                  "language": "xml"
