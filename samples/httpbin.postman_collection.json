    {
      "name": "2 · Request bodies",
      "item": [
        {
          "name": "JSON body",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"user\": \"{{username}}\", \"id\": {{userId}}, \"tags\": [\"sample\", \"json\"], \"active\": true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post"
              ]
