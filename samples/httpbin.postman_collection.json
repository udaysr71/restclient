  "item": [
    {
      "name": "1 · Basics",
      "item": [
        {
          "name": "Simple GET",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/get",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "get"
              ]
