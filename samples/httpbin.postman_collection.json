    {
      "name": "8 · Capture, built-ins, uploads",
      "item": [
        {
          "name": "Capture a value",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"sampleUuid\", pm.response.json()[\"uuid\"]);",
                  "pm.environment.set(\"sampleType\", pm.response.headers.get(\"Content-Type\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "uuid"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Use the captured value",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/anything/{{sampleUuid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "anything",
                "{{sampleUuid}}"
              ]
            }
          },
          "response": []
