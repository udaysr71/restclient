          "response": []
        },
        {
          "name": "Text body",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "Any text you like.\nVariables work here too: {{greeting}}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Form body",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "message",
                  "value": "spaces & symbols are encoded",
                  "type": "text"
                },
                {
                  "key": "skipped",
                  "value": "disabled rows aren't sent",
                  "type": "text",
                  "disabled": true
